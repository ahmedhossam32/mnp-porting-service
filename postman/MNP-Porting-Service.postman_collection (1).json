{
  "info": {
    "name": "MNP Porting Service - Full Test Suite",
    "description": "Comprehensive scenario coverage for the MNP Porting Service API: create, accept, reject, list, get-by-id, and phone-status endpoints, including business rules, validation, and HTTP-level edge cases.",

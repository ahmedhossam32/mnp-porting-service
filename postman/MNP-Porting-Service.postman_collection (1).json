    {
      "name": "8. Scheduled Expiry Job (manual verification)",
      "item": [
        {
          "name": "8.1 Create request to observe expiry (note id, wait 2+ min, then re-check via Get By Id)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('lifecycleId', pm.response.json().id);",
            "console.log('Created request id ' + pm.response.json().id + ' - wait 2+ minutes then run 8.2 to confirm it auto-cancels');"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "organization", "value": "orange" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"phoneNumber\": \"01090005555\"}" },
            "url": "{{baseUrl}}/porting-requests"
          }
        },
        {
          "name": "8.2 Re-check after 2+ minutes - should now be CANCELED",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('status is CANCELED', () => pm.expect(pm.response.json().status).to.eql('CANCELED'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "organization", "value": "orange" }],
            "url": "{{baseUrl}}/porting-requests/{{lifecycleId}}"
          }
        }
      ]
    }

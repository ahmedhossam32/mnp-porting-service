  "item": [
    {
      "name": "1. Create - Happy Path & Business Rules",
      "item": [
        {
          "name": "1.1 Create - valid request (fresh number)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "const json = pm.response.json();",
            "pm.test('donorOperator is VODAFONE', () => pm.expect(json.donorOperator).to.eql('VODAFONE'));",
            "pm.test('status is PENDING', () => pm.expect(json.status).to.eql('PENDING'));",
            "pm.collectionVariables.set('acceptTargetId', json.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "organization", "value": "orange" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"phoneNumber\": \"{{sharedPhone1}}\"}" },
            "url": "{{baseUrl}}/porting-requests"
          }
        },
        {
          "name": "1.2 Create - duplicate pending (409)",
